{
  "name": "trunk.js",
  "version": "1.0.0-alpha.0",
  "description": "Application structure for subtree.js apps: typed dependency narrowing (pick), AuthHandler with retry-after-reauth, and the Deps/Routing/Flow conventions.",
  "keywords": [
    "subtree",
    "architecture",
    "dependencies",
    "auth",
    "result"
  ],
  "license": "MIT",
  "author": "Volodymyr Kubiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkubiv/subtree.js.git",
    "directory": "packages/trunk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "operation-result.js": "^1.0.0"
  }
}
