{
  "name": "subtree.js",
  "version": "2.0.0-alpha.0",
  "description": "State management that separates state injection from state observation: Rx fields, controllers with sync/subscribe, and React bindings with explicit observer.watch.",
  "keywords": [
    "state",
    "observer",
    "subtree",
    "react",
    "controller",
    "rx"
  ],
  "license": "MIT",
  "author": "Volodymyr Kubiv",
  "homepage": "https://github.com/vkubiv/subtree.js#readme",
  "bugs": {
    "url": "https://github.com/vkubiv/subtree.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkubiv/subtree.js.git",
    "directory": "packages/subtree"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
